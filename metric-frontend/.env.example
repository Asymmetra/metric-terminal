# ── Imperial (upstream perps router) — the frontend calls these directly ──
# Defaults to the public hosts if unset.
NEXT_PUBLIC_IMPERIAL_API_URL=https://api.imperial.space
NEXT_PUBLIC_IMPERIAL_WS_URL=wss://api.imperial.space

# ── Phoenix (direct order book + live mid/price feed) ──
NEXT_PUBLIC_PHOENIX_API_URL=https://perp-api.phoenix.trade
NEXT_PUBLIC_PHOENIX_WS_URL=wss://perp-api.phoenix.trade/ws

# ── Solana RPC — used to submit deposit/withdraw transactions.
# Use a dedicated mainnet endpoint (Helius / QuickNode / Triton). If unset, the app
# falls back to solana-rpc.publicnode.com (public, browser-friendly), which is
# rate-limited and fine only for light/demo use.
NEXT_PUBLIC_SOLANA_RPC=

# ── Active signer implementation: "phantom" (default) or "privy-stub" ──
NEXT_PUBLIC_SIGNER=phantom

# ── Optional: metric-backend (WS fan-out + candle aggregation + health probe).
# The terminal works fully without it (Phoenix WS + Imperial REST are called direct);
# leaving these blank just shows the backend as "down" in the health panel.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
