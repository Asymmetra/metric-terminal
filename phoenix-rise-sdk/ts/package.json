{
  "name": "@ellipsis-labs/rise",
  "version": "0.3.0",
  "packageManager": "bun@1.3.9",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ellipsis-Labs/phoenix.git",
    "directory": "ts/rise"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "engines": {
    "bun": ">=1.3.9"
  },
  "description": "Rise SDK - Phoenix HTTP client",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "audit": "bun audit",
    "build": "bun --bun ./node_modules/tsdown/dist/run.mjs",
    "check": "bun run type-check",
    "codegen:routes": "bun --bun run scripts/generate-route-catalog.ts",
    "circular-check": "bun --bun run madge --circular src/index.ts",
    "dev": "bun --bun ./node_modules/tsdown/dist/run.mjs --watch",
    "fmt": "bun --bun run prettier --write .",
    "fmt:check": "bun --bun run prettier --check .",
    "lint": "bun --bun ./node_modules/eslint/bin/eslint.js src --ext .ts",
    "lint:fix": "bun --bun ./node_modules/eslint/bin/eslint.js src --ext .ts --fix",
    "publish:alpha": "bun --bun run scripts/publish-alpha.ts",
    "prepare": "bun run build",
    "prepublishOnly": "bun run build",
    "test": "bun --bun ./node_modules/vitest/vitest.mjs run --passWithNoTests",
    "type-check": "bunx tsc --noEmit",
    "upload:s3-tarball": "uv run ../scripts/upload_s3_tarball.py"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "@scure/base": "^2.0.0",
    "@solana/kit": "^4.0.0",
    "xstate": "^5.28.0",
    "zod": "^4.3.6"
  },
  "overrides": {
    "brace-expansion": ">=5.0.5",
    "flatted": "3.4.2",
    "minimatch": ">=10.2.3",
    "picomatch": ">=4.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.21",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "madge": "^8.0.0",
    "prettier": "^3.8.1",
    "tsdown": "^0.20.0-beta.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
